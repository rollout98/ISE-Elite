<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ISE.Elite.NinjaTrader8</RootNamespace>
    <AssemblyName>ISE.Elite.NT8</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NinjaTraderInstallDir Condition="'$(NinjaTraderInstallDir)' == ''">C:\Program Files\NinjaTrader 8</NinjaTraderInstallDir>
    <NinjaTraderCustomDir Condition="'$(NinjaTraderCustomDir)' == ''">$(USERPROFILE)\Documents\NinjaTrader 8\bin\Custom</NinjaTraderCustomDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ISE.NinjaTraderHost\ISE.NinjaTraderHost.csproj" />
    <ProjectReference Include="..\..\src\ISE.BrokerExecution\ISE.BrokerExecution.csproj" />
    <ProjectReference Include="..\..\src\ISE.ExecutionCoordinator\ISE.ExecutionCoordinator.csproj" />
    <ProjectReference Include="..\..\src\ISE.NinjaTraderAdapter\ISE.NinjaTraderAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NinjaTrader.Core">
      <HintPath>$(NinjaTraderInstallDir)\bin\NinjaTrader.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NinjaTrader.Gui">
      <HintPath>$(NinjaTraderInstallDir)\bin\NinjaTrader.Gui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ISE.Elite.NT8.config.template" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployToNinjaTrader" AfterTargets="Build">
    <MakeDir Directories="$(NinjaTraderCustomDir)" />
    <ItemGroup>
      <IseBridgeDependency Include="$(TargetDir)ISE.*.dll" Exclude="$(TargetPath)" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NinjaTraderCustomDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IseBridgeDependency)" DestinationFolder="$(NinjaTraderCustomDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)ISE.Elite.NT8.config.template"
          DestinationFiles="$(NinjaTraderCustomDir)\ISE.Elite.NT8.config.template"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
