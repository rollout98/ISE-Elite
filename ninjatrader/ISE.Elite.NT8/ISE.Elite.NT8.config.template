# ISE Elite NinjaTrader 8 bridge configuration
# Copy this file to:
#   %USERPROFILE%\Documents\NinjaTrader 8\bin\Custom\ISE.Elite.NT8.config
#
# This build is intentionally locked to Sim101 and one instrument.

AccountName=Sim101
InstrumentRoot=MNQ
InstrumentFullName=MNQ 09-26

# Disabled by default. Do not enable until the configured limit price is
# non-marketable and has been reviewed immediately before the smoke test.
SmokeTestEnabled=false
SmokeTestLimitPrice=0

# Protective execution remains disabled until the NT8 stop/target path has
# compiled and completed a supervised Sim101 fill test.
ProtectionEnabled=false
ProtectiveStopTicks=40
ProtectiveTargetTicks=80
EmergencyFlattenOnProtectionFailure=true
